# PostgreSQL (local: docker compose up -d, then migrate — see README)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/moms_game?schema=public"

# Google AI (optional)
GOOGLE_API_KEY=""
GOOGLE_MODEL="gemma-3-27b-it"

# OpenAI (server only — /api/chat, /api/pet-image “Generate AI portrait”, pet win lines; restart dev after change)
OPENAI_API_KEY=""
# Optional override (defaults to gpt-4o-mini)
OPENAI_CHAT_MODEL="gpt-4o-mini" 

# ElevenLabs text-to-speech (server only — /api/tts, optional “Listen” in chat)
# Create a key: https://elevenlabs.io/app/settings/api-keys
# ELEVENLABS_API_KEY=""
# Terminal quickstart (George + eleven_v3 + play): `npm run elevenlabs:tts-example` — needs ffmpeg/ffplay
# Optional: default voice and model (see https://elevenlabs.io/docs/models)
# ELEVENLABS_VOICE_ID="JBFqnCBsd6RMkjVDRZzb"
# ELEVENLABS_MODEL_ID="eleven_multilingual_v2"
# Optional: `npm run elevenlabs:create-agent` — Conversational AI agent
# ELEVENLABS_CONVAI_AGENT_NAME="A–Z Haven companion"
# ELEVENLABS_CONVAI_SYSTEM_PROMPT="You are a warm, cozy in-game companion..."

# Optional: log assistant previews to DB for review (set to "1")
CHAT_AUDIT_LOG="0"

# After adding AVIF/WebP to public/images/, enable modern <picture> sources
NEXT_PUBLIC_ENABLE_DOG_SOURCES="0"

# Optional ambient loop — set only after adding the file under public/audio/
# NEXT_PUBLIC_AMBIENT_AUDIO=/audio/ambient-cozy.mp3

# Single-clip “mom’s dog” for pet SFX: add public/sounds/moms-dog.mp3, set to 1. Mutually exclusive with the 13-file set below.
# NEXT_PUBLIC_USE_MOMS_DOG_SFX=0

# Set to 1 only after adding public/sounds/dogs/01.mp3 … 13.mp3 (otherwise soft synth SFX, no 404s). Ignored if USE_MOMS_DOG is 1.
# NEXT_PUBLIC_ENABLE_DOG_SFX_FILES=0

# App URL for Stripe redirects (production: https://your-domain.com)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional: comma-separated extra origins allowed for the Checkout `Origin` header (previews, staging)
# ALLOWED_APP_ORIGINS="https://preview.example.com"

# Stripe (server) — cosmetic checkout + webhooks
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Optional: publishable key if you add Stripe.js Elements later
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
